{
  "collectionName": "components_shared_review_items",
  "info": {
    "displayName": "Review Item",
    "icon": "quote"
  },
  "attributes": {
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string"
    },
    "content": {
      "type": "text",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5
    }
  }
}
