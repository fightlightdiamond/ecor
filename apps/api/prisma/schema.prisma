// Prisma schema — migration nguồn từ Laravel be/ (MySQL) sang PostgreSQL.
//
// Chiến lược: giữ cấu trúc bảng 1-1 với Laravel. Models được bổ sung dần
// theo từng domain nghiệp vụ (xem docs/MIGRATION-LARAVEL-TO-NESTJS.md):
//   Phase 1 Catalog → Phase 2 Content → Phase 3 Cart → Phase 4 Order → ...
//
// Cách thêm model khi đã có DB:  pnpm --filter @thang-long/api prisma:pull
// Cách đẩy schema xuống DB rỗng: pnpm --filter @thang-long/api prisma:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 1 — Catalog
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String?
  translations Json?
  price        Decimal  @default(0) @db.Decimal(10, 2)
  priceUnit    String?  @default("VND") @map("price_unit") // đơn vị tiền tệ: k/M/B/$/VND
  stock        Int      @default(0)
  sku          String?  @unique
  images       Json?
  status       String   @default("draft")
  categoryId   Int?     @map("category_id")
  customFields Json?    @map("custom_fields")
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String
  sku       String?  @unique
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("warehouses")
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  userId     Int      @map("user_id")
  rating     Int
  comment    String?
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Danh mục (gói TomatoPHP CMS) — dùng chung cho products & posts (cột `for`).
model Category {
  id          Int      @id @default(autoincrement())
  teamId      Int?     @map("team_id")
  parentId    Int?     @map("parent_id")
  for         String?  @default("posts")
  type        String?  @default("category")
  name        Json
  slug        String   @unique
  description Json?
  icon        String?
  color       String?
  isActive    Boolean? @default(true) @map("is_active")
  showInMenu  Boolean? @default(false) @map("show_in_menu")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

// Người dùng nội bộ (admin). Phase 9 sẽ bổ sung RBAC/relations còn lại.
model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  emailVerifiedAt        DateTime? @map("email_verified_at")
  password               String
  isAdmin                Boolean   @default(false) @map("is_admin")
  avatarUrl              String?   @map("avatar_url")
  twoFactorSecret        Json?     @map("two_factor_secret")
  twoFactorRecoveryCodes Json?     @map("two_factor_recovery_codes")
  passkeyCredentialId    String?   @map("passkey_credential_id")
  phone                  String?
  address                String?
  rememberToken          String?   @map("remember_token")
  createdAt              DateTime? @map("created_at")
  updatedAt              DateTime? @map("updated_at")

  reviews Review[]
  carts   Cart[]
  orders  Order[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Cart & Coupon
// ─────────────────────────────────────────────────────────────────────────

model Cart {
  id        Int       @id @default(autoincrement())
  sessionId String?   @map("session_id")
  userId    Int?      @map("user_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        Int       @id @default(autoincrement())
  cartId    Int       @map("cart_id")
  productId Int       @map("product_id")
  quantity  Int       @default(1)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Coupon {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String    @default("fixed")
  value     Decimal   @db.Decimal(10, 2)
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 — Order & Checkout
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id              Int       @id @default(autoincrement())
  userId          Int?      @map("user_id")
  // customer_id: FK tới customers (Phase 7) — tạm để Int? không quan hệ.
  customerId      Int?      @map("customer_id")
  number          String    @unique
  customerName    String?   @map("customer_name")
  customerEmail   String?   @map("customer_email")
  customerPhone   String?   @map("customer_phone")
  shippingAddress String?   @map("shipping_address")
  status          String    @default("new")
  paymentMethod   String    @default("cod") @map("payment_method")
  paymentStatus   String    @default("pending") @map("payment_status")
  paymentMeta     Json?     @map("payment_meta")
  shippingFee     Decimal   @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  taxFee          Decimal   @default(0) @map("tax_fee") @db.Decimal(10, 2)
  totalPrice      Decimal   @default(0) @map("total_price") @db.Decimal(10, 2)
  notes           String?
  trackingNumber  String?   @map("tracking_number")
  carrier         String?
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               Int       @id @default(autoincrement())
  orderId          Int       @map("order_id")
  productId        Int?      @map("product_id")
  productVariantId Int?      @map("product_variant_id")
  qty              Int
  price            Decimal   @db.Decimal(10, 2)
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 6 — Booking  &  Phase 7 — Customer (CRM)
// (FK để dạng scalar — truy vấn theo where, không cần quan hệ Prisma)
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  email     String?
  password  String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("customers")
}

model Appointment {
  id            Int       @id @default(autoincrement())
  customerId    Int?      @map("customer_id")
  customerName  String    @map("customer_name")
  customerPhone String    @map("customer_phone")
  customerEmail String?   @map("customer_email")
  service       String?
  staffId       Int?      @map("staff_id")
  scheduledAt   DateTime? @map("scheduled_at")
  status        String    @default("pending")
  notes         String?
  metadata      Json?
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@index([status, scheduledAt])
  @@index([customerPhone])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @map("appointment_id")
  status        String
  changedBy     Int?      @map("changed_by")
  notes         String?
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@map("appointment_status_histories")
}

model ContactInquiry {
  id          Int       @id @default(autoincrement())
  type        String    @default("contact")
  name        String
  phone       String
  email       String?
  service     String?
  message     String?
  preferredAt DateTime? @map("preferred_at")
  metadata    Json?
  source      String    @default("website")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("contact_inquiries")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 8 — Support  &  Phase 9 — Teams (admin)
// ─────────────────────────────────────────────────────────────────────────

model Ticket {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  subject   String
  message   String
  status    String    @default("open")
  priority  String    @default("normal")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("tickets")
}

model TicketResponse {
  id        Int       @id @default(autoincrement())
  ticketId  Int       @map("ticket_id")
  userId    Int       @map("user_id")
  message   String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("ticket_responses")
}

model Message {
  id         Int       @id @default(autoincrement())
  senderId   Int       @map("sender_id")
  receiverId Int       @map("receiver_id")
  content    String
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("messages")
}

model Team {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("teams")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — Content / Site
// ─────────────────────────────────────────────────────────────────────────

// Bài viết (gói TomatoPHP CMS). title/short_description/body/meta là JSON dịch.
model Post {
  id               Int       @id @default(autoincrement())
  authorId         Int?      @map("author_id")
  authorType       String?   @map("author_type")
  categoryId       Int?      @map("category_id")
  type             String?   @default("post")
  title            Json
  slug             String    @unique
  shortDescription Json?     @map("short_description")
  keywords         Json?
  body             Json?
  isPublished      Boolean   @default(false) @map("is_published")
  isTrend          Boolean   @default(false) @map("is_trend")
  publishedAt      DateTime? @map("published_at")
  likes            Float     @default(0)
  views            Float     @default(0)
  metaUrl          String?   @map("meta_url")
  meta             Json?
  metaRedirect     String?   @map("meta_redirect")
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("posts")
}

// Khối nội dung storefront (settings/team/services/gallery/testimonials).
model StorefrontSection {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  label     String
  content   Json
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("storefront_sections")
}

// Media (gói awcodes/curator) — dùng để resolve ID ảnh sản phẩm thành URL.
model Media {
  id          Int      @id @default(autoincrement())
  disk        String   @default("public")
  directory   String   @default("media")
  visibility  String   @default("public")
  name        String
  path        String
  width       Int?
  height      Int?
  size        Int?
  type        String   @default("image")
  ext         String
  alt         String?
  title       String?
  description String?
  caption     String?
  exif        String?
  curations   String?
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("media")
}
