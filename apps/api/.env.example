# Application
NODE_ENV=development
PORT=3001            # API dùng cổng riêng để không đụng Nuxt frontend (3000)
# CORS: FE storefront (3000) + Admin SPA React (3002), ngăn cách bởi dấu phẩy
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Database (PostgreSQL — Docker service `postgres` từ docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thanglongcheviet?schema=public

# Redis (Docker service `redis`)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Media (resolve ID ảnh Curator → URL; khớp Laravel public disk = APP_URL/storage)
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/storage

# Mail (Mailpit dev — best-effort, lỗi không ảnh hưởng nghiệp vụ)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@thanglongcheviet.vn
STOREFRONT_ADMIN_EMAIL=admin@thanglongcheviet.vn
STOREFRONT_SITE_NAME=Thăng Long Chè Việt

# Admin (AdminJS) — bí mật cookie phiên đăng nhập admin
ADMIN_COOKIE_SECRET=thang-long-che-viet-admin-secret-change-me-32chars

# Storefront content (fallback file JSON cho /storefront/site khi DB section trống)
STOREFRONT_DATA_DIR=resources/storefront

# VNPay (Phase 5 — để trống/enabled=false = chỉ COD; payment cô lập, lỗi không ảnh hưởng phần khác)
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_EXPIRY_MINUTES=15
STOREFRONT_FRONTEND_URL=http://localhost:3000

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=thanglongcheviet-uploads
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PRESIGNED_URL_EXPIRATION=3600
