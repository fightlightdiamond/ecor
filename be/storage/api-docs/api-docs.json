                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/storefront/posts/latest": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "Get latest posts",
                "description": "Returns latest 3 posts",
                "operationId": "getLatestPosts",
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
