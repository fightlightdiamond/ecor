{
    "openapi": "3.0.0",
    "info": {
        "title": "Thăng Long Chè Việt — Storefront API",
        "description": "Public REST API for Nuxt storefront: products, blog, cart, orders, booking, contact. Admin UI uses Filament at /admin.",
        "contact": {
            "email": "admin@thanglongcheviet.vn"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8002",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/storefront/coupons/validate": {
            "post": {
                "tags": [
                    "Coupons"
                ],
                "summary": "Validate coupon code",
                "description": "Check whether a coupon is valid and compute discount for the current cart total.",
                "operationId": "validateCoupon",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "cart_total"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "SUMMER10"
                                    },
                                    "cart_total": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 500000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Validation result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "properties": {
                                                "valid": {
                                                    "type": "boolean"
                                                },
                                                "code": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "type": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "value": {
                                                    "type": "number",
                                                    "nullable": true
                                                },
                                                "discount": {
                                                    "type": "number",
                                                    "nullable": true
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/storefront/products/{slug}/reviews": {
            "get": {
                "tags": [
                    "Products",
                    "Reviews"
                ],
                "summary": "List approved product reviews",
                "operationId": "getProductReviews",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "maximum": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Review list"
                    },
                    "404": {
                        "description": "Product not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/storefront/booking": {
            "post": {
                "tags": [
                    "Booking"
                ],
                "summary": "Submit salon/spa booking request",
                "description": "Creates a booking inquiry for salon services. Stored in admin under Contact Inquiries.",
                "operationId": "submitBooking",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Nguyễn Văn A"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "0901234567"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "nullable": true
                                    },
                                    "service": {
                                        "description": "Service slug or name",
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "staff_id": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "preferred_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-01",
                                        "nullable": true
                                    },
                                    "preferred_time": {
                                        "type": "string",
                                        "example": "10:00",
                                        "nullable": true
                                    },
                                    "note": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking submitted"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/api/storefront/booking/availability": {
            "get": {
                "tags": [
                    "Booking"
                ],
                "summary": "Available booking time slots",
                "description": "Returns 30-minute slots for a given date based on salon hours and existing bookings.",
                "operationId": "getBookingAvailability",
                "parameters": [
                    {
                        "name": "date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-07-01"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Slot list"
                    },
                    "422": {
                        "description": "Invalid date"
                    }
                }
            }
        },
        "/api/customer/appointments": {
            "get": {
                "tags": [
                    "Customer"
                ],
                "summary": "List my appointments",
                "operationId": "customerAppointments",
                "responses": {
                    "200": {
                        "description": "Appointment list"
                    }
                },
                "security": [
                    {
                        "customerBearer": []
                    }
                ]
            }
        },
        "/api/customer/appointments/{id}": {
            "delete": {
                "tags": [
                    "Customer"
                ],
                "summary": "Cancel appointment (>24h before scheduled time)",
                "operationId": "cancelCustomerAppointment",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cancelled"
                    },
                    "400": {
                        "description": "Cannot cancel"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "customerBearer": []
                    }
                ]
            }
        },
        "/api/customer/register": {
            "post": {
                "tags": [
                    "Customer"
                ],
                "summary": "Register customer account",
                "operationId": "customerRegister",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "minLength": 6
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registered"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/customer/login": {
            "post": {
                "tags": [
                    "Customer"
                ],
                "summary": "Customer login",
                "operationId": "customerLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authenticated"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/customer/logout": {
            "post": {
                "tags": [
                    "Customer"
                ],
                "summary": "Revoke customer token",
                "operationId": "customerLogout",
                "responses": {
                    "200": {
                        "description": "Logged out"
                    }
                },
                "security": [
                    {
                        "customerBearer": []
                    }
                ]
            }
        },
        "/api/customer/profile": {
            "get": {
                "tags": [
                    "Customer"
                ],
                "summary": "Customer profile",
                "operationId": "customerProfile",
                "responses": {
                    "200": {
                        "description": "Profile"
                    }
                },
                "security": [
                    {
                        "customerBearer": []
                    }
                ]
            }
        },
        "/api/customer/orders": {
            "get": {
                "tags": [
                    "Customer"
                ],
                "summary": "List my orders",
                "operationId": "customerOrders",
                "responses": {
                    "200": {
                        "description": "Order list"
                    }
                },
                "security": [
                    {
                        "customerBearer": []
                    }
                ]
            }
        },
        "/api/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "API health check",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "Service is up",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "version": {
                                            "type": "string",
                                            "example": "1.0.0"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/storefront/site": {
            "get": {
                "tags": [
                    "Site"
                ],
                "summary": "Get site content bundle",
                "description": "Returns settings, team, services, gallery and testimonials JSON for the storefront.",
                "operationId": "getSiteBundle",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Site bundle",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiSuccessEnvelope"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/storefront/sitemap": {
            "get": {
                "tags": [
                    "Site"
                ],
                "summary": "Sitemap slugs",
                "description": "Product and blog post slugs with updated_at for XML sitemap generation.",
                "operationId": "getSitemap",
                "responses": {
                    "200": {
                        "description": "Sitemap data"
                    }
                }
            }
        },
        "/api/storefront/products/featured": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get featured products",
                "operationId": "getFeaturedProducts",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Featured products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Product"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/storefront/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "List products",
                "operationId": "getProductsList",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 12,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated product list"
                    }
                }
            }
        },
        "/api/storefront/products/{slug}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Product detail",
                "operationId": "getProductBySlug",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product with related items"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/api/storefront/categories": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Product categories",
                "operationId": "getCategories",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category list"
                    }
                }
            }
        },
        "/api/storefront/posts/latest": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "Latest blog posts",
                "operationId": "getLatestPosts",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Latest posts"
                    }
                }
            }
        },
        "/api/storefront/posts": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "List blog posts",
                "operationId": "getPostsList",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 9,
                            "maximum": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated posts"
                    }
                }
            }
        },
        "/api/storefront/posts/{slug}": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "Blog post detail",
                "operationId": "getPostBySlug",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Post detail"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/api/storefront/cart": {
            "get": {
                "tags": [
                    "Cart"
                ],
                "summary": "Get cart",
                "operationId": "getCart",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/LangQuery"
                    },
                    {
                        "$ref": "#/components/parameters/SessionIdHeader"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart with line items"
                    }
                }
            }
        },
        "/api/storefront/cart/add": {
            "post": {
                "tags": [
                    "Cart"
                ],
                "summary": "Add item to cart",
                "operationId": "addToCart",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/SessionIdHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "product_id"
                                ],
                                "properties": {
                                    "product_id": {
                                        "type": "integer"
                                    },
                                    "quantity": {
                                        "type": "integer",
                                        "default": 1,
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Added"
                    },
                    "400": {
                        "description": "Stock exceeded"
                    },
                    "404": {
                        "description": "Product unavailable"
                    }
                }
            }
        },
        "/api/storefront/cart/update": {
            "post": {
                "tags": [
                    "Cart"
                ],
                "summary": "Update cart line quantity",
                "operationId": "updateCart",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/SessionIdHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_id",
                                    "quantity"
                                ],
                                "properties": {
                                    "item_id": {
                                        "type": "integer"
                                    },
                                    "quantity": {
                                        "description": "Set 0 to remove",
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated"
                    }
                }
            }
        },
        "/api/storefront/cart/remove": {
            "post": {
                "tags": [
                    "Cart"
                ],
                "summary": "Remove cart line",
                "operationId": "removeFromCart",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/SessionIdHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_id"
                                ],
                                "properties": {
                                    "item_id": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Removed"
                    }
                }
            }
        },
        "/api/storefront/checkout": {
            "post": {
                "tags": [
                    "Cart",
                    "Orders"
                ],
                "summary": "Place order from cart",
                "operationId": "checkout",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/SessionIdHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone",
                                    "address"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string"
                                    },
                                    "address": {
                                        "type": "string"
                                    },
                                    "coupon_code": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Order created"
                    },
                    "400": {
                        "description": "Empty cart or invalid coupon"
                    }
                }
            }
        },
        "/api/storefront/contact": {
            "post": {
                "tags": [
                    "Contact"
                ],
                "summary": "Submit contact form",
                "operationId": "submitContact",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "nullable": true
                                    },
                                    "service": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "message": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "source": {
                                        "type": "string",
                                        "example": "website",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Submitted"
                    }
                }
            }
        },
        "/api/storefront/orders/lookup": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Lookup order by number and phone",
                "operationId": "lookupOrder",
                "parameters": [
                    {
                        "name": "number",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "ORD-20260625-ABC123"
                        }
                    },
                    {
                        "name": "phone",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "0901234567"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order found"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiSuccessEnvelope": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "object"
                    },
                    "message": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ApiErrorEnvelope": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Not found"
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 5
                    },
                    "total": {
                        "type": "integer",
